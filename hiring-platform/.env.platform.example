# Proof-of-Work Hiring Platform - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiring_platform

# ============================================================================
# REDIS (for caching and background jobs)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# API KEYS
# ============================================================================

# OpenAI API Key (required for AI code analysis)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# GitHub Personal Access Token (required for repo analysis)
# Get from: https://github.com/settings/tokens
# Scopes needed: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=ghp_...

# ============================================================================
# SECURITY
# ============================================================================

# Secret key for JWT tokens (generate a random string)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT algorithm
ALGORITHM=HS256

# Token expiry (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# APPLICATION
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Enable SQL query logging (true/false)
SQL_ECHO=false

# API URL (for CORS, webhooks, etc.)
API_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================================================================
# EXTERNAL SERVICES (Optional)
# ============================================================================

# Sentry DSN (for error tracking)
SENTRY_DSN=

# AWS credentials (for S3 file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# SendGrid API key (for email notifications)
SENDGRID_API_KEY=

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable AI interview bot
ENABLE_AI_INTERVIEW=true

# Enable commit analysis
ENABLE_COMMIT_ANALYSIS=true

# Enable automated evaluation scoring
ENABLE_AUTO_SCORING=true

# ============================================================================
# RATE LIMITING
# ============================================================================

# Max evaluations per HR manager per day
MAX_EVALUATIONS_PER_DAY=10

# Max submissions per candidate per month
MAX_SUBMISSIONS_PER_MONTH=5

# ============================================================================
# BACKGROUND JOBS
# ============================================================================

# Celery broker URL (usually same as REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0
